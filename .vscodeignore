# VSCode extension ignore file
# Files and directories to exclude when publishing to VSCode marketplace

.vscode/**
.vscode-test/**
.gitignore
vsc-extension-quickstart.md

# Source files
src/**
tsconfig.json
dprint.json

# Build tools
node_modules/**
pnpm-lock.yaml
pnpm-workspace.yaml

# Zed extension files (exclude from VSCode package)
extension.toml
themes/**

# Documentation (keep only essential ones)
ARCHITECTURE.md
PUBLISHING.md
QUICK_START.md
MIGRATION_COMPLETE.md
VERIFICATION_REPORT.md

# Development files
.DS_Store
*.vsix
